# IDE
.vscode/
.idea/
*.sublime-*

# Archives (user can delete)
archive/

# Toolchains (too large for git)
clang-*/
gcc-*/
*.tar.gz
*.zip

# Disk images
*.dmg
*.sparseimage

# Temporary files
tmp/
temp/
*.tmp

