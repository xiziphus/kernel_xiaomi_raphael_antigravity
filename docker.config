CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_KEYS=y
CONFIG_VETH=y
CONFIG_OVERLAY_FS=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
# CONFIG_NETFILTER_XT_MATCH_IPVS depends on CONFIG_IP_VS, which raphael_defconfig
# leaves unset, so olddefconfig has silently dropped it from every build to date --
# including the shipped v1.0. IPVS is only used by Docker Swarm's load balancer.
# Left disabled deliberately: enabling it would mean pulling in the whole IP_VS
# stack for a feature this device will never run. Commented out rather than
# deleted so the build's flag-retention check reports a clean 0 losses instead of
# prompting on a known-benign miss every single run.
# CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_IP_NF_NAT=y
CONFIG_NF_NAT=y
CONFIG_POSIX_MQUEUE=y

# =============================================================================
# Headless-server additions
# Base: SOVIET-ANDROID/kernel_xiaomi_raphael branch 16.0 @ 01e68ce70 (4.14.357)
# =============================================================================

# --- nftables backend --------------------------------------------------------
# Debian bookworm ships iptables-nft as the default alternative, so dockerd's
# rule programming lands on the nft backend. Without these, Docker networking
# fails unless you force:
#   update-alternatives --set iptables /usr/sbin/iptables-legacy
#
# 4.14 still splits NAT/masquerade/redirect per address family. The short
# generic symbols (NFT_NAT / NFT_MASQ / NFT_REDIR) are NOT sufficient alone --
# the *_IPV4 / *_IPV6 and NFT_CHAIN_NAT_* symbols carry the real functionality.
# Verified against net/{netfilter,ipv4/netfilter,ipv6/netfilter}/Kconfig in this
# tree; these names do not exist under those spellings in modern kernels.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_CHAIN_NAT_IPV4=y
# IPv6 NAT gates NFT_CHAIN_NAT_IPV6 / NFT_MASQ_IPV6 / NFT_REDIR_IPV6. Without it
# those three are dropped by olddefconfig. NF_CONNTRACK_IPV6 and
# NETFILTER_ADVANCED (its other dependencies) are already =y in this tree.
# Docker only needs IPv4 NAT by default, but `dockerd --ipv6` with ip6tables is
# a one-flag change in userspace and would otherwise cost a full kernel rebuild.
CONFIG_NF_NAT_IPV6=y
CONFIG_NFT_CHAIN_NAT_IPV6=y
CONFIG_NFT_CHAIN_ROUTE_IPV4=y
CONFIG_NFT_CHAIN_ROUTE_IPV6=y
CONFIG_NFT_MASQ_IPV4=y
CONFIG_NFT_MASQ_IPV6=y
CONFIG_NFT_REDIR_IPV4=y
CONFIG_NFT_REDIR_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_META=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y
CONFIG_NFT_SET_HASH=y
CONFIG_NFT_SET_RBTREE=y
CONFIG_NFT_SET_BITMAP=y

# --- disable Polly ------------------------------------------------------------
# raphael_defconfig sets CONFIG_LLVM_POLLY=y, which makes Makefile:763 append
# eight flags enabling LLVM's polyhedral loop optimizer:
#
#   -polly -polly-reschedule=1 -polly-loopfusion-greedy=1 -polly-postopts=1
#   -polly-vectorizer=stripmine -polly-run-inliner -polly-ast-use-context
#   -polly-invariant-load-hoisting   (+ -polly-run-dce)
#
# Polly schedules via the polyhedral model, whose ISL solver is exponential in
# the worst case. On this tree it fails to converge:
#
#   qca-wifi-host-cmn/umac/regulatory/core/src/reg_build_chan_list.c
#   -- a 1245-line file -- ran 20+ minutes at 99% CPU on a single core with the
#   build otherwise idle, and never completed. -polly-reschedule and
#   -polly-loopfusion-greedy are the expensive knobs and both are on.
#
# Turning the Kconfig symbol off removes all eight flags via the ifdef; no source
# patching required. This is purely a throughput optimization aimed at tight
# numeric loop nests -- it has no correctness or ABI effect, and is close to
# worthless for a container host, which is syscall- and I/O-bound.
#
# MLGO register allocation and hot-cold-split (Makefile:760-762) are NOT gated by
# this symbol and remain enabled, so the build keeps the rest of the tree's
# tuning. Revert by deleting this line if you ever want Polly back.
# CONFIG_LLVM_POLLY is not set

# --- section mismatch handling -------------------------------------------------
# raphael_defconfig line 703 explicitly sets "# CONFIG_SECTION_MISMATCH_WARN_ONLY
# is not set", overriding the Kconfig default of y, so modpost treats any section
# mismatch as fatal:
#
#   WARNING: modpost: Found 1 section mismatch(es).
#   FATAL: modpost: Section mismatches detected.
#   make[2]: *** [scripts/Makefile.modpost:113: vmlinux.o] Error 1
#
# The stock config produces zero mismatches; the single mismatch appears only
# once the flags above are added. A mismatch is a reference from code that
# survives boot into __init memory that is freed afterwards -- benign if the path
# is never taken post-init, a crash if it is. Worth identifying rather than
# silencing blind, especially on a device meant to run unattended.
#
# DEBUG_SECTION_MISMATCH makes modpost print which symbols are involved (without
# it, modpost.c reports only the count and suppresses detail). WARN_ONLY keeps
# the build going so one run yields both a kernel and the diagnosis.
#
# NOTE: DEBUG_SECTION_MISMATCH adds -fno-inline-functions-called-once, a small
# codegen change. Once the mismatch is understood, drop it and rebuild if you
# want an image whose codegen matches the tree's defaults exactly.
CONFIG_SECTION_MISMATCH_WARN_ONLY=y
CONFIG_DEBUG_SECTION_MISMATCH=y

# --- loadable module support -------------------------------------------------
# Safe alongside LTO here: LTO_CLANG (arch/Kconfig:669) carries no !MODULES
# dependency, and raphael_defconfig sets no CFI_CLANG, TRIM_UNUSED_KSYMS,
# MODULE_SIG or MODVERSIONS to complicate it.
# NOTE: nothing installs /lib/modules on the device. Keep anything you actually
# need at =y -- a driver that lands as =m will simply never be loadable.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

# --- debugfs + tracing -------------------------------------------------------
# LTO_CLANG depends on "!FTRACE_MCOUNT_RECORD || HAVE_C_RECORDMCOUNT", and
# arch/arm64/Kconfig:114 selects HAVE_C_RECORDMCOUNT -- so DYNAMIC_FTRACE and
# LTO do coexist on arm64. Keep DYNAMIC_FTRACE=y: without it FUNCTION_TRACER
# pays the mcount cost on every call unconditionally, which is the wrong
# trade on a fanless always-on device.
# DEBUG_FS IS DISABLED DELIBERATELY -- IT DOES NOT COMPILE ON THIS TREE EITHER.
#
# Qualcomm's IPA driver calls debugfs helpers from inside "#ifdef CONFIG_DEBUG_FS"
# without including the header that declares them, and -Werror kills the build:
#
#   drivers/platform/msm/ipa/ipa_clients/ipa_eth.c:131  implicit declaration of 'ipa3_eth_debugfs_init'
#   drivers/platform/msm/ipa/ipa_clients/ipa_eth.c:675  implicit declaration of 'ipa3_eth_debugfs_add_node'
#
# The functions do exist (declared ipa_v3/ipa_i.h:2917, defined ipa_debugfs.c:3134,
# stubbed :3443), so this specific break is a one-line missing include. It is NOT
# patched here because eight further files under drivers/platform/msm/ipa/ alone
# carry CONFIG_DEBUG_FS ifdefs that have likewise never been compiled, and
# DEBUG_FS is a tree-wide switch -- each additional break costs a ~20 minute
# rebuild to discover. The device's current working kernel runs without DEBUG_FS,
# so leaving it off keeps parity with a known-good configuration.
# CONFIG_DEBUG_FS=y
#
# TRACING IS DISABLED DELIBERATELY -- IT DOES NOT COMPILE ON THIS TREE.
#
# Enabling CONFIG_FTRACE instantiates the TRACE_EVENT macros for real (they are
# no-ops otherwise), and that exposes two pre-existing bugs in this source tree
# which raphael_defconfig never hits because it ships with ftrace off:
#
#   drivers/android/binder_trace.h:400  use of undeclared identifier 'binder_command_strings'
#   drivers/android/binder_trace.h:416  use of undeclared identifier 'binder_return_strings'
#   kernel/trace/trace_event_perf.c:433 redefinition of 'event'
#
# 9 errors, confined entirely to those two files -- nothing in netfilter or the
# module infrastructure, so nftables and CONFIG_MODULES above are unaffected.
#
# This is NOT the LTO/recordmcount incompatibility one might expect: the Kconfig
# guard "!FTRACE_MCOUNT_RECORD || HAVE_C_RECORDMCOUNT" is satisfied on arm64
# (arch/arm64/Kconfig:114) and the config merge is clean at 63/63. The tree
# simply does not build with tracepoints instantiated.
#
# Re-enabling requires patching both files, which diverges from upstream on a
# device that has to boot unattended. DEBUG_FS above is kept -- it is
# independent of tracing and costs nothing.
# CONFIG_FTRACE=y
# CONFIG_FUNCTION_TRACER=y
# CONFIG_DYNAMIC_FTRACE=y
# CONFIG_FUNCTION_GRAPH_TRACER=y
