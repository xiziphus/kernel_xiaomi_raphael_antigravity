# Helium 5.4 (zundamon-miui-5.4) needs this to build any device tree at all:
# arch/arm64/boot/dts/qcom/Makefile gates everything behind MACH_XIAOMI_SM8150,
# and the shipped raphael_defconfig sets only MACH_XIAOMI_RAPHAEL. Without it
# dtb-y/dtbo-y are empty, so `make dtbs` produces nothing and there is no base
# dtb to append to Image.gz.
CONFIG_MACH_XIAOMI_SM8150=y
CONFIG_MACH_XIAOMI_RAPHAEL=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y
